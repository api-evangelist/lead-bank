        {
          "info": {
            "name": "Retrieve an ACH",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.lead.bank/v1/ach/:ach_id",
            "params": [
              {
                "name": "ach_id",
                "value": "ach_xyz001",
                "type": "path",
                "description": "ID of the ACH object you want to retrieve."
              }
            ]
          },
          "docs": "Retrieve an ACH object."
        },
        {
          "info": {
            "name": "Update an ACH",
            "type": "http"
