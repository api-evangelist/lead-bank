          "docs": "List all ACH objects."
        },
        {
          "info": {
            "name": "Create an ACH",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sandbox.lead.bank/v1/ach",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
