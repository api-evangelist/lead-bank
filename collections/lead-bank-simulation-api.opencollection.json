{
  "opencollection": "1.0.0",
  "info": {
    "name": "Lead Bank Account Number Simulation API",
    "version": "v1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
