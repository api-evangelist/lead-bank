{
  "opencollection": "1.0.0",
  "info": {
    "name": "Lead Bank Account Number OAuth API",
    "version": "v1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "OAuth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get an Access Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sandbox.lead.bank/v1/oauth/token",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Exchange your client credentials for an access code."
        }
      ]
    }
  ],
  "bundled": true
}